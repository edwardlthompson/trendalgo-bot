<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrendAlgo.Shell.Views.CoinEventsTimelineWindow"
        Icon="avares://TrendAlgo.Shell/Assets/app-icon.ico"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Close" Click="OnClose" MinWidth="88" />
    </StackPanel>
    <TextBlock x:Name="HintText" DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
    <Grid RowDefinitions="220,*">
      <Border Grid.Row="0" Background="#141414" CornerRadius="4" Padding="8" Margin="0,0,0,8">
        <Panel>
          <TextBlock x:Name="EmptyChart" Text="No price series for timeline"
                     Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Canvas x:Name="SparkCanvas" MinHeight="200" SizeChanged="OnCanvasSized" />
        </Panel>
      </Border>
      <DataGrid Grid.Row="1"
                x:Name="Grid"
                IsReadOnly="True"
                CanUserSortColumns="True"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
          <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
          <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
          <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
