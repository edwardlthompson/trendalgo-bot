<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrendAlgo.Shell.Views.LaunchPromptWindow"
        Icon="avares://TrendAlgo.Shell/Assets/app-icon.ico"
        Title="TrendAlgo"
        Width="460" Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Name="LaterBtn" Content="Later" Click="OnLater" />
      <Button Name="AcceptBtn" Content="Donate" Click="OnAccept" />
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Name="BodyText" TextWrapping="Wrap" />
      <ScrollViewer Name="NotesScroll" MaxHeight="180" IsVisible="False">
        <TextBlock Name="NotesText" TextWrapping="Wrap" Opacity="0.85" />
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</Window>
