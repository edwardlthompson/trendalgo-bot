<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrendAlgo.Shell.Views.ScanProgressWindow"
        Icon="avares://TrendAlgo.Shell/Assets/app-icon.ico"
        Title="Scan progress"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Close" Click="OnClose" MinWidth="88" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <TextBlock Text="{Binding Phase}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PairGlance}" FontSize="14" />
      <TextBlock Text="{Binding EtaLabel}" Opacity="0.9" />
      <TextBlock Text="{Binding PairsLabel}" Opacity="0.75" FontSize="12" />
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8" />
      <TextBlock Text="{Binding PercentLabel}" Opacity="0.8" />
    </StackPanel>
    <!-- Status / log fills the rest of the window -->
    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10" Background="#0f172a">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <TextBlock Text="{Binding LogText}"
                   TextWrapping="Wrap"
                   FontFamily="Consolas,Cascadia Mono,monospace"
                   FontSize="12"
                   LineHeight="18" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
