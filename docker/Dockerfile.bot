# TrendAlgo headless bot host (ADR-0016; row 15). Builds for linux/amd64 and linux/arm64:
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/Dockerfile.bot -t trendalgo-botd .
# The base image is pinned by tag. Pin its digest at the first release (open item in W-OCI).
# Only base dependencies are installed (no extras), so TA-Lib is absent: the v1 live list is the
# six pandas indicators (L6). TLS key and certificate are mounted at runtime under /run/secrets.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:${PATH}" \
    TRENDALGO_BOTD_DIR=/data

RUN groupadd --system --gid 10001 bot \
 && useradd --system --uid 10001 --gid bot --home-dir /home/bot --create-home bot \
 && mkdir -p /data \
 && chown bot:bot /data \
 && pip install --no-cache-dir uv==0.11.21

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable \
 && uv cache clean

USER bot
VOLUME ["/data"]
EXPOSE 8443
CMD ["uvicorn", "trendalgo.botd.service:build_app", "--factory", "--host", "0.0.0.0", "--port", "8443", "--ssl-keyfile", "/run/secrets/botd.key", "--ssl-certfile", "/run/secrets/botd.crt"]
